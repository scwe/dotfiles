# Ghostty — replaces gnome-terminal as my daily driver.
# Reload in-place with ctrl+shift+,

# Font (FiraCode Nerd Font is installed via apt.sh)
font-family = "FiraCode Nerd Font"
font-size = 12

# Matches the molokai colorscheme in init.lua
theme = "Molokai"

# More scrollback than the 10k default
scrollback-limit = 100000

# Block cursor, no blink
cursor-style = block
cursor-style-blink = false

# Bit of breathing room around the buffer
window-padding-x = 8
window-padding-y = 8

# Don't pop a confirmation modal on window close
confirm-close-surface = false

# Quit when the last window goes away
quit-after-last-window-closed = true

# Surface a desktop notification on terminal bell (\a) AND play a sound.
# Default has no-system,no-audio which silently swallows Claude Code's
# "task complete" pings.
bell-features = system,audio,attention,title
bell-audio-path = /usr/share/sounds/freedesktop/stereo/bell.oga

# Chord prefix is ctrl+space (deliberately different from tmux's ctrl+s
# so the two can be nested: ghostty owns ctrl+space, tmux still owns
# ctrl+s, neither swallows the other's prefix). Same h/j/k/l + |/-
# muscle memory underneath.

# Pane navigation
keybind = ctrl+space>h=goto_split:left
keybind = ctrl+space>l=goto_split:right
keybind = ctrl+space>j=goto_split:bottom
keybind = ctrl+space>k=goto_split:top

# Splits — | horizontal, - vertical
keybind = ctrl+space>|=new_split:right
keybind = ctrl+space>-=new_split:down

# Close current pane (no confirm)
keybind = ctrl+space>x=close_surface

# Tabs
keybind = ctrl+space>c=new_tab
keybind = ctrl+space>n=next_tab
keybind = ctrl+space>p=previous_tab
